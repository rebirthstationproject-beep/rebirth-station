{
  "name": "@cubelist/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "큐브 리스트 모바일 앱 (Capacitor) — 리버스 스테이션",
  "scripts": {
    "build:web": "cd ../web && NEXT_PUBLIC_RUNTIME=capacitor npm run build && cd ../mobile",
    "sync": "npm run build:web && cap sync",
    "android:add": "cap add android",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "ios:add": "cap add ios",
    "ios:open": "cap open ios",
    "ios:run": "cap run ios",
    "doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/device": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "cordova-plugin-purchase": "^13.10.0",
    "@awesome-cordova-plugins/in-app-purchase-2": "^6.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "typescript": "^5.6.0"
  }
}
