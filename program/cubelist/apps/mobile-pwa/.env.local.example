# 큐브 리스트 웹 UI 환경변수
# 실제 사용 시 .env.local에 복사하고 값을 채워주세요. .env.local은 .gitignore에 포함.

# Supabase (jusomoa 본체와 동일 프로젝트 사용 가능)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...

# 런타임 분기 — Tauri 빌드 시 'tauri'
NEXT_PUBLIC_RUNTIME=web

# PC 헬퍼 LAN URL (기본값은 ws-client.ts 상수)
# NEXT_PUBLIC_HELPER_URL=ws://127.0.0.1:23456/ws
