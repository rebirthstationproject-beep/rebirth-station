{
  "name": "@cubelist/web",
  "version": "0.1.0",
  "private": true,
  "description": "큐브 리스트 웹 UI — 리버스 스테이션",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:tauri": "cross-env NEXT_PUBLIC_RUNTIME=tauri next build",
    "build:manifest": "node scripts/build-cubeone-manifest.mjs",
    "prebuild:tauri": "npm run build:manifest && npm run refresh:plugins && npm run validate:plugins && npm run validate:spec",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prevalidate:plugins": "npm run mirror:plugins",
    "validate:plugins": "node ../../scripts/validate-plugin-manifests.mjs",
    "mirror:plugins": "node ../../scripts/mirror-plugin-manifests.mjs",
    "refresh:plugins": "node ../../scripts/refresh-plugin-index.mjs",
    "postrefresh:plugins": "npm run mirror:plugins",
    "validate:spec": "node ../../scripts/validate-spec-paths.mjs",
    "export": "next build && next export -o out",
    "clean": "rimraf .next out"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.3.0",
    "embla-carousel-react": "^8.3.0",
    "html5-qrcode": "^2.3.8",
    "jszip": "^3.10.1",
    "next": "^15.0.0",
    "nosleep.js": "^0.12.0",
    "qrcode.react": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.11.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.47",
    "rimraf": "^5.0.10",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.0"
  }
}
