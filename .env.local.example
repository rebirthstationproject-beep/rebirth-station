# Rebirth Station 환경변수 템플릿
# Vercel Project Settings + 로컬 .env.local 양쪽 모두 설정

# 사이트
NEXT_PUBLIC_SITE_URL=https://rebirthstation.com

# Supabase (Phase 1.3 가입 후)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (Phase 1.5 발급 후)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GSC 검증 (Phase 1.2 도메인 연결 후)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# Analytics (Phase 1.2 도메인 연결 후)
NEXT_PUBLIC_GA_ID=

# 비밀번호·시크릿 키 (자동 발급)
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://rebirthstation.com

# IAP (Phase 8 사업자 등록 후)
APPLE_APP_STORE_SHARED_SECRET=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# 외부 API (선택)
ANTHROPIC_API_KEY=
FAL_API_KEY=
